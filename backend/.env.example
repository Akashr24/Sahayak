# Sahayak — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env to source control.

# ── Twilio credentials (https://console.twilio.com) ──────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx   # Your purchased Twilio number
# (optional) Fallback / alert number to notify the duty officer by SMS/call
TWILIO_ALERT_NUMBER=+91XXXXXXXXXX

# ── Public base URL of this backend server ────────────────────────────────────
# When using ngrok:       https://xxxx-xx-xx-xxx-xx.ngrok-free.app
# When using a VPS/EC2:  https://your-domain.in
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app

# ── Optional Google Cloud Speech-to-Text (higher accuracy than google STT) ───
# Leave blank to use the free google SR backend
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# ── Sahayak station config ────────────────────────────────────────────────────
STATION_NAME=Shirva Police Station
HELPLINE_NUMBER=+918047250112
DUTY_OFFICER_PHONE=+91XXXXXXXXXX
